FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
# claude_cli = local Claude Code CLI login (no API key); anthropic = Anthropic API (LLM_API_KEY or ANTHROPIC_API_KEY)
LLM_PROVIDER=claude_cli
LLM_API_KEY=
# anthropic provider defaults to claude-opus-5-5; leave empty to use the CLI's default model
LLM_MODEL=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# comma-separated origins allowed to call the API (add your hosted web app URL)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
